# ค่าตอน build บน Vercel (production) — โหมดเดโม: MSW ตอบแทน Supabase ข้อมูลเก็บในเบราว์เซอร์ของแต่ละคน
# ใช้ Supabase จริงเมื่อไร: ตั้ง Environment Variables ใน Vercel (ทับค่าในไฟล์นี้) ห้ามใส่ service_role key
VITE_ENABLE_MOCK=true
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=mock-publishable-key
